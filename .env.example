# Docker: docker compose up -d --build. Копировать этот файл не обязательно.
DOCKER_DEMO_MODE=true
DEMO_MODE=true
DEMO_DATA=true
APP_PORT=3210
POSTGRES_PORT=54329
POSTGRES_ADMIN_PASSWORD=local-admin-password
POSTGRES_APP_PASSWORD=local-app-password
# Только для запуска Node без Docker:
DATABASE_URL=postgresql://dobrie_dela_app:local-app-password@127.0.0.1:54329/dobrie_dela
DB_SCHEMA=app
DB_POOL_SIZE=10
PORT=3210
HOST=127.0.0.1

# Production: DEMO_MODE=false, DOCKER_DEMO_MODE=false, DEMO_DATA=false;
# заменить оба пароля. Ключ и CA монтируются через compose.production.yaml.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_MINI_APP_URL=
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
MAX_POLLING=false
PRIVATE_DATA_ENCRYPTION_KEY_FILE=
DB_TLS_CA_FILE=
REQUIRE_PRIVATE_DATA_ENCRYPTION=false
CATALOG_ANNOTATED_ONLY=false
RECOMMENDATION_V2_ENABLED=true
RECSYS_URL=http://127.0.0.1:3211

# Только для изолированного HTTPS-демо compose.production.yaml; задать сильные разные пароли.
DEMO_POSTGRES_ADMIN_PASSWORD=
DEMO_POSTGRES_PASSWORD=

# В демо внешние вызовы заблокированы независимо от этих переключателей.
CATALOG_CITIES=Москва,Санкт-Петербург,Казань,Рыбинск
CATALOG_SYNC_ENABLED=false
CATALOG_SYNC_ON_START=false
CATALOG_SYNC_INTERVAL_MS=3600000
DOBRO_CONCURRENCY=4
ANNOTATION_ENABLED=false
ANNOTATION_CONCURRENCY=20
ANNOTATION_BATCH_SIZE=100
ANNOTATION_POLL_INTERVAL_MS=15000
LLM_API_KEY=
LLM_BASE_URL=
DOCKER_LLM_BASE_URL=
LLM_MODEL=gpt-6-luna

# Необязательно: запуск уже загруженного релизного образа
# APP_IMAGE=helpi:v2026.09.29
# APP_COMMIT=<commit>

# Local demo is available without Telegram credentials.
PORT=3210
HOST=127.0.0.1
DEMO_MODE=true
DB_PATH=./var/app.sqlite
# For a NEW Telegram bot: HTTPS address, DEMO_MODE=false, one server process.
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
MINI_APP_URL=
# Optional: use the same webhook secret locally and in Vercel.
# If omitted, a secret is derived from the bot token on both sides.
TELEGRAM_WEBHOOK_SECRET=

# Локальная демонстрация без токена MAX (cookie-сессия)
DEMO_MODE=true
PORT=3210
HOST=127.0.0.1
DB_PATH=./var/app.sqlite

# MAX Bot API. Токен хранится только на сервере.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_MINI_APP_URL=https://example.ru

# Production Webhook (HTTPS, сертификат доверенного УЦ, включая Минцифры)
MAX_WEBHOOK_URL=https://example.ru/api/max/webhook
MAX_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Для локальной разработки с токеном: true; при активной подписке webhook — false
MAX_POLLING=true
# MAX_CA_BUNDLE=./russiantrustedca.pem

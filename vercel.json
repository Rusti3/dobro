{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": { "api/[[...path]].js": { "runtime": "nodejs22.x", "maxDuration": 10 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[[...path]].js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

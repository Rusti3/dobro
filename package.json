{
  "name": "dobrie-dela-max",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "worker": "node --env-file-if-exists=.env server/worker.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.js",
    "catalog:sync": "node --env-file-if-exists=.env scripts/run-catalog-sync.js",
    "annotations:queue": "node --env-file-if-exists=.env scripts/run-annotation-queue.js",
    "integration:postgres": "node scripts/integration-postgres.js",
    "bot:polling": "node --env-file-if-exists=.env scripts/start-polling.js",
    "test": "node --test tests/*.test.js",
    "annotations:validate": "node scripts/validate-annotation-gold.js",
    "bot:setup": "node --env-file-if-exists=.env scripts/setup-bot.js",
    "webhook:setup": "node --env-file-if-exists=.env scripts/setup-webhook.js",
    "test:demo": "node scripts/test-demo-api.mjs",
    "test:ui": "node scripts/test-garden-ui.mjs",
    "secrets:check": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "0.468.0",
    "maplibre-gl": "^6.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.186.0",
    "vite": "7.3.6"
  }
}
